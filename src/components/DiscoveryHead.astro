---
/**
 * Reader-discovery head tags (P9 UX F3): Open Graph + Twitter cards on
 * every wired page, JSON-LD on article pages (`Article`) and the home
 * page (plain `WebSite` — no `SearchAction`: the site has no search).
 *
 * Gated by the optional `discovery:` block in site.config.yaml via
 * src/lib/discovery.ts — defaults are ALL ON; set a key to false there to
 * drop these tags from every page.
 *
 * og:image: the template ships no social image asset and invents none.
 * This site took the documented client extension: `static/social-card.png`
 * (generated once, committed) plus the og:image tags below, so shares get
 * a real preview card (twitter `summary_large_image`) instead of the
 * plain `summary` fallback the template emits.
 *
 * `path` is the base-relative route ('' on home, `pages/<id>/` on
 * articles) — the same id-derived shape pages use for internal links, so
 * og:url stays consistent with hrefs: a base-aware absolute URL built
 * from BASE_URL + SITE (never Astro.url, whose pathname shape is not a
 * contract across build.format/trailingSlash combinations).
 */
import { resolveDiscovery } from '../lib/discovery';

interface Props {
  type: 'website' | 'article';
  title: string;
  description?: string;
  /** Base-relative route: '' on the home page, `pages/<id>/` on articles. */
  path: string;
  /** Publish date (pages frontmatter `date:`); omitted on undated pages. */
  date?: unknown;
}

const { type, title, description, path, date } = Astro.props;
const siteName = 'Kara Hokes, PhD';
const siteDescription = 'Online trauma therapy with Kara Hokes, PhD, a clinical psychologist licensed in Washington State and PSYPACT certified. CPT, DBT, ACT, PE, and CBT by secure video for veterans, survivors of sexual and domestic violence, and under-represented communities. Free 15-minute consultation; most major insurance accepted; $150 self-pay.';
const author = 'Kara Hokes, PhD';

const discovery = resolveDiscovery();
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(`${import.meta.env.BASE_URL}${path}`, import.meta.env.SITE);
const ogDescription = description ?? siteDescription;
// Social card: base-aware absolute URL, same construction as `canonical`
// (BASE_URL keeps /site-scratch-practice/ correct on GitHub Pages).
const socialCard = new URL(`${import.meta.env.BASE_URL}social-card.png`, import.meta.env.SITE).href;

const published =
  date !== undefined && date !== null && !Number.isNaN(new Date(date as string | Date).getTime())
    ? new Date(date as string | Date)
    : undefined;

const articleJsonld =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: fullTitle,
        // datePublished/author appear only when the data exists: pages
        // carry `date:` only if the site added it (schema has no date
        // field by default) and the copier `author` question may be ''.
        ...(published ? { datePublished: published.toISOString() } : {}),
        ...(author ? { author: { '@type': 'Person', name: author } } : {}),
        mainEntityOfPage: canonical.href,
      }
    : undefined;

// WebSite on the home page ONLY (task contract); other website-type pages
// (graph, entity lists) get cards but no JSON-LD.
const homeJsonld =
  type === 'website' && path === ''
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: canonical.href,
      }
    : undefined;

const jsonld = discovery.jsonld ? (articleJsonld ) : undefined;
---

{
  discovery.opengraph && (
    <>
      <meta property="og:site_name" content={siteName} />
      <meta property="og:type" content={type} />
      <meta property="og:title" content={fullTitle} />
      <meta property="og:description" content={ogDescription} />
      <meta property="og:url" content={canonical.href} />
      <meta property="og:image" content={socialCard} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Kara Hokes, PhD — online trauma therapy in Washington State" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={socialCard} />
      <meta name="twitter:title" content={fullTitle} />
      <meta name="twitter:description" content={ogDescription} />
    </>
  )
}
{
  jsonld && (
    <script
      type="application/ld+json"
      // A raw `</script>` inside the payload (reachable: title/site_name/
      // author are CMS-editable) would terminate the element and corrupt
      // the head. Escaping every `<` as \u003c keeps the HTML inert while
      // staying byte-identical under JSON.parse.
      set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')}
    />
  )
}
